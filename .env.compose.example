# Copy to .env.compose. Set the verified PBL6 volume and its matching password.
# If Face Auth runs on another machine, bind to this server's LAN IP (or 0.0.0.0)
# and restrict port 5432 with the host firewall; keep 127.0.0.1 for local runtime.
PBL6_POSTGRES_VOLUME=backend_postgres_data
PBL6_POSTGRES_PASSWORD='postgres'
PBL6_POSTGRES_PORT=5432
PBL6_POSTGRES_BIND_IP=127.0.0.1
PBL6_PGADMIN_EMAIL=admin@example.com
PBL6_PGADMIN_PASSWORD=5911d0a8f1ef9191c4e1f1cc565bd2ad
PBL6_PGADMIN_PORT=5050
# Optional full application profile: --profile app
PBL6_WEB_PORT=8080
PBL6_WEB_BIND_IP=127.0.0.1
PBL6_BACKEND_PORT=3000
PBL6_FACE_API_PORT=5000
PBL6_FACE_MODEL_PACK=buffalo_s
# Optional existing host cache; contains models/buffalo_s/*.onnx.
# PBL6_INSIGHTFACE_CACHE=/absolute/path/to/.insightface
PBL6_CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# HTTP local testing; production requires HTTPS for Secure cookies.
PBL6_NODE_ENV=development
# If the DB password includes URL special characters, set an encoded URL:
# PBL6_DOCKER_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@postgres:5432/PBL6?schema=public
PBL6_DOCKER_DATABASE_URL='postgresql://postgres:postgres@postgres:5432/PBL6?schema=public'
