# Sao chép thành .env.compose; chạy Compose từ thư mục gốc repository.
# Local: docker compose --env-file .env.compose -f docker-compose.yml --profile app up -d --build
# Cloud: docker compose --env-file .env.compose -f docker-compose.cloud.yml up -d --build
# Hai base là lựa chọn riêng, không ghép với nhau hoặc với base Phase 1.

# CHỈ stack local: volume external phải tồn tại và đúng database/mật khẩu.
# Không tạo volume trống thay cho volume dữ liệu cần giữ.
PBL6_POSTGRES_VOLUME=backend_postgres_data
PBL6_POSTGRES_PASSWORD=change-me-local-db-password
PBL6_POSTGRES_PORT=5432
PBL6_POSTGRES_BIND_IP=127.0.0.1
# Khi password có ký tự đặc biệt, đặt URL đã percent-encode dưới đây.
# Bỏ trống biến bằng cách comment cả dòng để Compose tự ghép URL từ password.
# PBL6_DOCKER_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@postgres:5432/PBL6?schema=public

# pgAdmin tùy chọn: --profile tools.
PBL6_PGADMIN_EMAIL=admin@example.com
PBL6_PGADMIN_PASSWORD=change-me-pgadmin-password
PBL6_PGADMIN_PORT=5050

# Cổng host. PostgreSQL/backend/Face Auth chỉ bind loopback theo manifest.
PBL6_WEB_PORT=8080
PBL6_WEB_BIND_IP=127.0.0.1
PBL6_BACKEND_PORT=3000
PBL6_FACE_API_PORT=5000
PBL6_CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
PBL6_NODE_ENV=development

# Base local/cloud đọc TRUST_PROXY/intervals từ các biến này.
PBL6_TRUST_PROXY_HOPS=1
PBL6_OPERATION_RECOVERY_INTERVAL_MS=900000
PBL6_ATTENDANCE_ALERTS_INTERVAL_MS=900000
PBL6_FACE_DB_POOL_TIMEOUT_SECONDS=5
PBL6_FACE_DB_QUERY_TIMEOUT_MS=5000
PBL6_FACE_MODEL_PACK=buffalo_s
# PBL6_INSIGHTFACE_CACHE=/absolute/path/to/.insightface

# Local base lấy cờ/key bên dưới qua interpolation cho hai service.
# Cloud base lấy chúng từ backend/.env và face_auth/.env.
# Dùng cùng key ở cả ba nơi; thay chuỗi mẫu bằng key ngẫu nhiên >=32 ký tự.
FACE_LOGIN_ENABLED=false
FACE_AUTH_INTERNAL_KEY=change-me-internal-key-at-least-32-characters
# Đường dẫn TRONG container, thư mục hardware/models được mount tại /app/login-models.
# Base local/cloud này tắt adaptive; chọn runtime JSON đã kiểm chứng nếu bật face login.
FACE_LOGIN_PAD_RUNTIME_CONFIG_PATH=

# Override HTTPS của cloud base: thêm -f docker-compose.local-https.yml.
# Cần chứng chỉ local trong docker/certs theo hướng dẫn của override.
PBL6_HTTPS_PORT=8443
PBL6_HTTPS_CORS_ORIGIN=https://localhost:8443
