# Sao chép thành .env.iot; cấu hình bổ sung ThingsBoard/MediaMTX.
# docker compose --env-file .env.iot -f docker-compose.iot.yml up -d
# Thay IP mẫu bằng IP LAN/VPN của máy Docker để Pi truy cập được.
IOT_SERVER_HOST=192.168.1.50

# Loopback chỉ cho máy Docker truy cập. Khi Pi ở máy khác, đổi bind sang IP LAN/VPN
# tương ứng và giới hạn bằng firewall; không mở cổng quản trị/MQTT trực tiếp ra Internet.
IOT_BIND_IP=127.0.0.1
TB_ADMIN_BIND_IP=127.0.0.1
MEDIAMTX_MEDIA_BIND_IP=127.0.0.1
TB_WEB_PORT=8081

# Giữ phiên bản trong manifest; kiểm tra image/kiến trúc đích trước khi đổi tag.
TB_IMAGE=thingsboard/tb-postgres:3.8.1
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.9.3
