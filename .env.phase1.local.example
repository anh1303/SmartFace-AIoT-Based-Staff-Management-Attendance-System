# Sao chép thành .env.phase1.local; base Phase 1 + override local HTTPS.
# docker compose -p smartface-phase1-local --env-file .env.phase1.local -f docker-compose.phase1.yml -f docker-compose.phase1.local-https.yml up -d --build
# Tạo HAI env_file bên dưới từ mẫu backend/face_auth; dùng database kiểm thử riêng.
# Đặt FACE_LOGIN_ENABLED=true và cùng FACE_AUTH_INTERNAL_KEY >=32 ký tự ở HAI file
# khi kiểm tra face login. Không dùng credential production cho UAT local.
PHASE1_BACKEND_ENV_FILE=./backend/.env.phase1.local
PHASE1_FACE_AUTH_ENV_FILE=./face_auth/.env.phase1.local

# Cần chứng chỉ local đáng tin cậy trong docker/certs.
PHASE1_CORS_ORIGIN=https://localhost:8443
PHASE1_TRUST_PROXY_HOPS=2
PHASE1_HTTPS_PORT=8443
# HTTP chỉ để smoke UI; kiểm tra cookie/camera/face login qua HTTPS.
PHASE1_HTTP_SMOKE_PORT=8080
PHASE1_BACKEND_PORT=3000
PHASE1_FACE_API_PORT=5000

# Stack Phase 1 không có Pi, ThingsBoard hay MQTT.
PHASE1_IOT_HARDWARE_ENABLED=false
PHASE1_ENABLE_ATTENDANCE_CRON=false
PHASE1_OPERATION_RECOVERY_INTERVAL_MS=900000
PHASE1_ATTENDANCE_ALERTS_INTERVAL_MS=900000

PHASE1_FACE_MODEL_PACK=buffalo_s
PHASE1_FACE_DB_POOL_TIMEOUT_SECONDS=5
PHASE1_FACE_DB_QUERY_TIMEOUT_MS=5000
# Đường dẫn TRONG container, tương ứng hardware/models trên host.
# Giữ profile hiện có; giá trị hiệu chỉnh không thay nghiệm thu webcam/holdout.
PHASE1_PAD_RUNTIME_CONFIG_PATH=/app/login-models/R7_SC_FULL_crop15_runtime_config.json
PHASE1_PAD_ADAPTIVE_ENABLED=true
PHASE1_PAD_ADAPTIVE_CONFIG_PATH=/app/login-models/R7_SC_FULL_pi_final_conservative_runtime.json
# PHASE1_INSIGHTFACE_CACHE=/absolute/path/to/.insightface
