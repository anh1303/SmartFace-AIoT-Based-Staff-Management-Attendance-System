# Sao chép thành .env.phase1.oci; base Phase 1 + override OCI HTTPS.
# docker compose -p smartface-phase1-oci --env-file .env.phase1.oci -f docker-compose.phase1.yml -f docker-compose.phase1.oci.yml up -d --build
# Thay domain mẫu, cấu hình DNS và cho Caddy truy cập cổng 80/443.
APP_DOMAIN=smartface.example.com
PHASE1_CORS_ORIGIN=https://smartface.example.com
PHASE1_CADDYFILE=./docker/Caddyfile.oci.example

# Tạo từ hai env.example, điền credential riêng của môi trường đích.
# Hai database URL backend và DATABASE_URL Python phải cùng database.
# Bật FACE_LOGIN_ENABLED ở HAI file khi dùng; cùng FACE_AUTH_INTERNAL_KEY >=32 ký tự.
PHASE1_BACKEND_ENV_FILE=./backend/.env.phase1.oci
PHASE1_FACE_AUTH_ENV_FILE=./face_auth/.env.phase1.oci
PHASE1_TRUST_PROXY_HOPS=2

# Chỉ Caddy công khai cổng; không có Pi/ThingsBoard/MQTT trong stack này.
PHASE1_IOT_HARDWARE_ENABLED=false
PHASE1_ENABLE_ATTENDANCE_CRON=false
PHASE1_OPERATION_RECOVERY_INTERVAL_MS=900000
PHASE1_ATTENDANCE_ALERTS_INTERVAL_MS=900000

PHASE1_FACE_MODEL_PACK=buffalo_s
PHASE1_FACE_DB_POOL_TIMEOUT_SECONDS=5
PHASE1_FACE_DB_QUERY_TIMEOUT_MS=5000
# Giữ model/profile hiện có; đây là đường dẫn container, không phải đường dẫn host.
PHASE1_PAD_RUNTIME_CONFIG_PATH=/app/login-models/R7_SC_FULL_crop15_runtime_config.json
PHASE1_PAD_ADAPTIVE_ENABLED=true
PHASE1_PAD_ADAPTIVE_CONFIG_PATH=/app/login-models/R7_SC_FULL_pi_final_conservative_runtime.json
# PHASE1_INSIGHTFACE_CACHE=/absolute/path/to/.insightface
