# ==============================================================================
# 1. BẢO MẬT & BẢO VỆ DỮ LIỆU NHẠY CẢM (Secrets & Environment)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
certs/

# ==============================================================================
# 2. THƯ MỤC NẶNG & BUILD ARTIFACTS (Dependencies, Builds, Cache)
# ==============================================================================
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.next/
.nuxt/
.turbo/
.vite/
.cache/
*.tsbuildinfo
coverage/
**/coverage/

# ==============================================================================
# 3. TESTS & KIỂM THỬ (Không đưa thư mục test lên Git)
# ==============================================================================
__tests__/
**/__tests__/
test/
**/test/
tests/
**/tests/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx

# ==============================================================================
# 4. MÔI TRƯỜNG PHÁT TRIỂN & HỆ ĐIỀU HÀNH (IDE & OS)
# ==============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ==============================================================================
# 5. LOGS & TEMPORARY FILES
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
uploads/
**/uploads/
temp/
tmp/
benchmark_cache/
*.npy
*.npz

# ==============================================================================
# 6. PYTHON & MÔI TRƯỜNG ẢO
# ==============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
**/venv/
env/
ENV/
.pytest_cache/
