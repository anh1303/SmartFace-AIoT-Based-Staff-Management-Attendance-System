NODE_ENV=development
PORT=3000

# Local development defaults. For cloud (Neon), replace BOTH URLs with endpoints for
# the same database/schema; DIRECT_URL must use the provider's direct endpoint.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/PBL6?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/PBL6?schema=public"
# Ví dụ Neon Cloud:
# DATABASE_URL="postgresql://<user>:<password>@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/PBL6?sslmode=require"
# DIRECT_URL="postgresql://<user>:<password>@ep-xxx.c-4.ap-southeast-1.aws.neon.tech/PBL6?sslmode=require"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_random_string_pbl6_2026_backend_v2
JWT_EXPIRES_IN=1d

# MQTT Broker (Tùy chọn cho các thiết bị IoT legacy)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEVICE_SECRET=pbl6_device_shared_secret_key_12345678
ENABLE_MQTT=false

# Mã hóa dữ liệu sinh trắc học & CORS
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173

# Face Authentication Service
FACE_AUTH_URL=http://localhost:5000
FACE_AUTH_TIMEOUT_MS=30000
FACE_AUTH_MODEL_VERSION=buffalo_s
FACE_MATCH_THRESHOLD=0.45

# ==========================================
# CẤU HÌNH THINGSBOARD IOT GATEWAY
# ==========================================
# Docker cùng network: TB_HOST=thingsboard, TB_HTTP_PORT=9090
# Backend chạy trực tiếp host: TB_HOST=127.0.0.1, TB_HTTP_PORT=8080
TB_HOST=127.0.0.1
TB_HTTP_PORT=8080
TB_DEVICE_NAME=PI4_FRONT_GATE
TB_DEVICE_TOKEN=
TB_DEVICE_UUID=
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=tenant

# Trusted ThingsBoard REST-node calls (Header X-TB-Webhook-Secret trong Rule Chain & Pi)
TB_WEBHOOK_SECRET=

# ==========================================
# CẤU HÌNH GỬI EMAIL TỰ ĐỘNG (SMTP)
# ==========================================
# Tự động gửi thông tin tài khoản đăng nhập cho nhân viên mới
# Nếu dùng Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<email_cua_ban>, SMTP_PASS=<mat_khau_ung_dung_16_ky_tu>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartFace AIoT" <no-reply@smartface.aiot>
CLIENT_URL=http://localhost:5173

# Số lượt nhận diện để chốt điểm danh (1 lượt: xác minh và ghi trong cùng RPC)
ATTENDANCE_STABLE_COUNT=1
# Thời gian chờ chống quét nhầm giữa 2 lần check-in liên tiếp (giây, demo có thể hạ xuống 5s)
ATTENDANCE_COOLDOWN_SECONDS=60

# ArcFace Server Offload (Tùy chọn)
REMOTE_RECOGNITION_ENABLED=true
# JSON map: device name -> separately generated random secret (at least 32 chars).
EDGE_RECOGNITION_KEYS={}
# Same random >=32-character value in face_auth/.env. Never distribute to Pi.
FACE_AUTH_INTERNAL_KEY=

# Webcam account login only. Leave disabled until the webcam/PAD trial succeeds.
FACE_LOGIN_ENABLED=false
# Login uses FACE_MATCH_THRESHOLD and ATTENDANCE_STABLE_COUNT, like Pi attendance.
