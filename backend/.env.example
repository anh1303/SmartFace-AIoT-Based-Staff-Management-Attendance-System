NODE_ENV=development
PORT=3000
# Local development defaults. For cloud, replace BOTH URLs with endpoints for
# the same database/schema; DIRECT_URL must use the provider's direct endpoint.
# DATABASE_URL may use the runtime pooler when the cloud provider supports it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/PBL6?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/PBL6?schema=public"
# Cloud Docker: use docker-compose.cloud.yml, which reads backend/.env.
# The local docker-compose.yml overrides DATABASE_URL with its local DB URL.
JWT_SECRET=super_secret_jwt_key_random_string_pbl6_2026_backend
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEVICE_SECRET=pbl6_device_shared_secret_key_12345678
ENABLE_MQTT=false
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGIN=http://localhost:5173
FACE_AUTH_URL=http://localhost:5000
FACE_AUTH_TIMEOUT_MS=30000
FACE_AUTH_MODEL_VERSION=buffalo_s

# SMTP Mail Service (Tự động gửi thông tin tài khoản cho nhân viên mới)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartFace AIoT" <no-reply@smartface.aiot>
CLIENT_URL=http://localhost:5173

# ThingsBoard REST API để đổi CHECK_IN/CHECK_OUT trên Pi.
# Docker cùng project pbl6: TB_HOST=thingsboard, TB_HTTP_PORT=9090.
# Backend chạy trực tiếp: TB_HOST=127.0.0.1, TB_HTTP_PORT=8081.
TB_HOST=thingsboard
TB_HTTP_PORT=9090
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=tenant
TB_DEVICE_TOKEN=
TB_DEVICE_UUID=

# Trusted ThingsBoard REST-node calls (same value in node header, >=24 chars).
TB_WEBHOOK_SECRET=

# Distinct consecutive face recognitions required for both device check-in/out.
ATTENDANCE_STABLE_COUNT=2

# OT/penalty review and absence penalties require Prisma migrations, not new env
# variables. absence_penalty_rate defaults to 0.25 in bonus_penalty and is edited
# by Admin in the payroll policy screen.

# Optional Pi ArcFace offload; independent from ThingsBoard webhook credentials.
REMOTE_RECOGNITION_ENABLED=true
# JSON map: device name -> separately generated random secret (at least 32 chars).
EDGE_RECOGNITION_KEYS={}
# Same random >=32-character value in face_auth/.env. Never distribute to Pi.
FACE_AUTH_INTERNAL_KEY=
