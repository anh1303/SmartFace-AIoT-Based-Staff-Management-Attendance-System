# Chạy trực tiếp: sao chép thành backend/.env. Giá trị mẫu chỉ dùng cho phát triển.
# Tạo khóa riêng: python -c "import secrets; print(secrets.token_hex(32))"
# Không thay BIOMETRIC_ENCRYPTION_KEY trên dữ liệu đã mã hóa nếu chưa có kế hoạch chuyển khóa.

# HTTP: 0 = trực tiếp, 1 = Nginx, 2 = Caddy -> Nginx -> backend.
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=pretty

# Hai URL phải cùng database/schema. Neon: DATABASE_URL có thể dùng pooler,
# DIRECT_URL dùng endpoint trực tiếp; thêm sslmode=require theo nhà cung cấp.
# Mật khẩu phải khớp .env.compose nếu dùng PostgreSQL local qua Docker.
DATABASE_URL=postgresql://postgres:change-me-local-db-password@127.0.0.1:5432/PBL6?schema=public
DIRECT_URL=postgresql://postgres:change-me-local-db-password@127.0.0.1:5432/PBL6?schema=public

# Mỗi secret tối thiểu 32 ký tự; thay TẤT CẢ chuỗi change-me bằng khóa riêng.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MQTT_DEVICE_SECRET=change-me-mqtt-device-secret-at-least-32-characters
BIOMETRIC_ENCRYPTION_KEY=change-me-biometric-key-at-least-32-characters

# Cùng key với face_auth/.env; không đưa internal key lên frontend/Pi.
# Trong Docker, Compose thay FACE_AUTH_URL bằng http://face-auth:5000.
FACE_AUTH_URL=http://127.0.0.1:5000
FACE_AUTH_INTERNAL_KEY=change-me-internal-key-at-least-32-characters
FACE_AUTH_TIMEOUT_MS=30000
FACE_AUTH_MODEL_VERSION=buffalo_s
FACE_MATCH_THRESHOLD=0.45
FACE_LOGIN_ENABLED=false

# Phải khớp Pi/simulator; số lượt recognition, không phải số frame/PAD votes.
ATTENDANCE_STABLE_COUNT=1
ATTENDANCE_MIN_EVENT_INTERVAL_SECONDS=600
ENABLE_ATTENDANCE_CRON=true
OPERATION_RECOVERY_INTERVAL_MS=900000
ATTENDANCE_ALERTS_INTERVAL_MS=900000
# ATTENDANCE_PERF_LOG=true

# MQTT legacy: tắt nếu không dùng; secret vẫn được env.ts kiểm tra.
ENABLE_MQTT=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ThingsBoard tùy chọn: để TB_HOST trống khi không dùng.
# Backend trên host: 127.0.0.1:8081. Cùng mạng Docker IoT: thingsboard:9090.
TB_HOST=
TB_HTTP_PORT=8081
TB_DEVICE_NAME=PI4_FRONT_GATE
TB_DEVICE_TOKEN=
TB_DEVICE_UUID=
TB_USERNAME=
TB_PASSWORD=
# Bật webhook: tạo secret >=24 ký tự, dùng cùng giá trị ở Rule Chain/simulator.
TB_WEBHOOK_SECRET=

# Direct attendance/vân tay và server recognition dùng token riêng theo device.
# Điền cùng token vào EDGE_RECOGNITION_TOKEN trên Pi; không dùng internal key.
REMOTE_RECOGNITION_ENABLED=false
EDGE_RECOGNITION_KEYS='{}'
# EDGE_RECOGNITION_KEYS='{"PI4_FRONT_GATE":"change-me-device-token-at-least-32-characters"}'

# Email tùy chọn; để trống host/user/pass nếu chưa cấu hình gửi thư.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='"SmartFace AIoT" <no-reply@example.com>'
