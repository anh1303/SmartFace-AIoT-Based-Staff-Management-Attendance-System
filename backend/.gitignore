# ==============================================================================
# BACKEND .GITIGNORE
# ==============================================================================

# 1. Bảo mật & Biến môi trường
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
certs/

# 2. Dependencies & Build Artifacts
node_modules/
dist/
build/
.cache/
*.tsbuildinfo
coverage/

# 3. Tests & Kiểm thử
# Test source is tracked; generated reports are ignored by the root .gitignore.

# 4. IDE & Hệ điều hành
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# 5. Logs & File tạm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*credentials*.json
uploads/
temp/
tmp/

# Keep business-policy regression tests with this module.
!validation/
!validation/*.test.ts
!validation/**/*.test.ts
