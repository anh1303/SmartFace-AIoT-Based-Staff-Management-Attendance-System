model BackgroundOperation {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id        String @db.Uuid
  owner           User @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type            String @db.VarChar(40)
  label           String @db.VarChar(200)
  idempotency_key String @db.Uuid
  input_hash      String @db.VarChar(64)
  status          String @default("queued") @db.VarChar(30)
  payload         Json @default("{}")
  result          Json?
  error           String? @db.Text
  total           Int @default(0)
  completed       Int @default(0)
  succeeded       Int @default(0)
  failed          Int @default(0)
  skipped         Int @default(0)
  revision        Int @default(1)
  attempts        Int @default(0)
  lease_token     String? @db.Uuid
  lease_until     DateTime? @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  input           BackgroundOperationInput?
  items           BackgroundOperationItem[]
  receipt         FaceEnrollmentReceipt?

  @@unique([owner_id, idempotency_key])
  @@index([status, lease_until, created_at], map: "background_operations_poll")
  @@index([owner_id, created_at(sort: Desc)], map: "background_operations_owner")
  @@map("background_operations")
}

model BackgroundOperationInput {
  operation_id String @id @db.Uuid
  operation    BackgroundOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ciphertext   Bytes
  expires_at   DateTime @default(dbgenerated("(now() + '24:00:00'::interval)")) @db.Timestamptz(6)
  @@map("background_operation_inputs")
}

model BackgroundOperationItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operation_id String @db.Uuid
  operation    BackgroundOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item_key     String @db.VarChar(150)
  payload      Json
  status       String @default("queued") @db.VarChar(20)
  error        String? @db.Text
  @@unique([operation_id, item_key])
  @@map("background_operation_items")
}
