/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model attendance_logs {
  id                 BigInt   @id @default(autoincrement())
  employee_id        String   @db.Uuid
  event_time         DateTime @default(now()) @db.Timestamptz(6)
  type               String   @db.VarChar(20)
  method             String   @default("FACE") @db.VarChar(20)
  device_info        String?  @db.VarChar(100)
  verification_score Float?
  liveness_score     Float?
  status             String   @default("VALID") @db.VarChar(30)
  event_key          String?  @unique @db.VarChar(180)
  work_date          DateTime? @db.Date
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  employees          Employee @relation(fields: [employee_id], references: [id], onUpdate: NoAction)

  @@index([employee_id, work_date], map: "attendance_logs_emp_work_date")
  @@index([employee_id, event_time(sort: Desc)], map: "idx_attendance_emp_time")
  @@index([type], map: "idx_attendance_type")
}

/// Bảng tổng hợp dữ liệu chấm công hàng ngày của từng nhân viên.
/// LƯU Ý QUAN TRỌNG: Tất cả các trường thời gian (total_working_hours, late_early, overtime)
/// đều được chuẩn hóa và lưu trữ thống nhất toàn hệ thống theo đơn vị GIỜ (HOURS) dạng Decimal(5,2).
model daily_attendance_summary {
  id                  BigInt       @id @default(autoincrement())
  employee_id         String       @db.Uuid
  work_date           DateTime     @db.Date
  shift_id            Int?
  first_check_in      DateTime?    @db.Timestamptz(6)
  last_check_out      DateTime?    @db.Timestamptz(6)
  total_working_hours Decimal      @default(0) @db.Decimal(5, 2)
  late_early          Decimal      @default(0) @db.Decimal(5, 2)
  overtime            Decimal      @default(0) @db.Decimal(5, 2)
  attendance_status   String       @default("PRESENT") @db.VarChar(30)
  regular_seconds     Int          @default(0)
  overtime_seconds    Int          @default(0)
  late_early_seconds  Int          @default(0)
  overtime_candidate_hours Decimal @default(0) @db.Decimal(7, 2)
  overtime_status     String       @default("NONE") @db.VarChar(20)
  overtime_reason     String?      @db.Text
  approved_by         String?      @db.VarChar(100)
  approved_at         DateTime?    @db.Timestamptz(6)
  requires_review     Boolean      @default(false)
  review_reason       String?      @db.Text
  review_status       String       @default("NONE") @db.VarChar(20)
  approval_source     String?      @db.VarChar(50)
  pre_approval_snapshot Json?
  approval_reason     String?      @db.Text
  manual_adjustment   Boolean?     @default(false)
  calculation_details Json?
  policy_version      String?      @db.VarChar(40)
  reopened_at         DateTime?    @db.Timestamptz(6)
  reopened_by         String?      @db.VarChar(100)
  updated_at          DateTime     @default(now()) @db.Timestamptz(6)
  employees           Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_shifts         work_shifts? @relation(fields: [shift_id], references: [id], onUpdate: NoAction)

  @@unique([employee_id, work_date], map: "uq_emp_work_date")
  @@index([work_date], map: "idx_daily_summary_date")
  @@index([attendance_status], map: "idx_daily_summary_status")
  @@index([review_status], map: "idx_daily_summary_review_status")
  @@index([reopened_at], map: "idx_daily_summary_reopened_at")
}

model attendance_locks {
  id        Int      @id @default(autoincrement())
  work_date DateTime @unique @db.Date
  is_locked Boolean  @default(true)
  locked_at DateTime @default(now()) @db.Timestamptz(6)
  locked_by String?  @db.VarChar(100)

  @@map("attendance_locks")
}

// One independently reviewed item per employee, shift date and category.
model AttendanceAdjustment {
  id                 BigInt   @id @default(autoincrement())
  employee_id        String   @db.Uuid
  work_date          DateTime @db.Date
  kind               String   @db.VarChar(20)
  hours              Decimal  @default(0) @db.Decimal(7, 2)
  amount             Decimal  @default(0) @db.Decimal(15, 2)
  status             String   @default("PENDING") @db.VarChar(20)
  note               String?  @db.Text
  reviewed_by        String?  @db.Uuid
  reviewed_at        DateTime? @db.Timestamptz(6)
  source_fingerprint String   @db.VarChar(64)
  source_details     Json
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  employee           Employee @relation(fields: [employee_id], references: [id], onUpdate: NoAction)

  @@unique([employee_id, work_date, kind])
  @@index([work_date, status])
  @@map("attendance_adjustments")
}

model AttendanceAggregationState {
  period     String   @id @db.VarChar(7)
  failed     Boolean  @default(false)
  run_id     String?  @db.Uuid
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@map("attendance_aggregation_state")
}

model AttendanceAlertCheckpoint {
  name        String   @id @db.VarChar(50)
  last_due_at DateTime @db.Timestamptz(6)

  @@map("attendance_alert_checkpoints")
}
