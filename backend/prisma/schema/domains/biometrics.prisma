model face_embeddings {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id    String                     @db.Uuid
  embedding      Unsupported("vector(512)")
  model_version  String                     @db.VarChar(50)
  sample_tag     String?                    @default("FRONTAL") @db.VarChar(50)
  quality_score  Float?
  is_active      Boolean                    @default(true)
  created_at     DateTime                   @default(now()) @db.Timestamptz(6)
  /// SAMPLE = vector gốc từng ảnh, CENTROID = vector trung bình đại diện danh tính
  embedding_type String                     @default("SAMPLE") @db.VarChar(20)
  employees      Employee                   @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_face_embeddings_emp_id")
  @@index([embedding_type], map: "idx_face_embeddings_type")
  @@index([embedding], map: "idx_face_embeddings_embedding_hnsw")
}

model FaceEnrollmentReceipt {
  operation_id String @id @db.Uuid
  operation    BackgroundOperation @relation(fields: [operation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee_id  String @db.Uuid
  employee     Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  result       Json
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  @@map("face_enrollment_receipts")
}

model FingerprintTemplate {
  id            String @id @default(uuid()) @db.Uuid
  employee_id   String @db.Uuid
  device_id     String
  revision      Int
  finger_name   String
  ciphertext    Bytes
  checksum      String @db.VarChar(64)
  match_score   Int
  sensor_model  String @default("ZA620_M5")
  status        String @default("PENDING")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  employee      Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  bindings      FingerprintBinding[]
  @@unique([employee_id, revision])
  @@map("fingerprint_templates")
}

model FingerprintBinding {
  id          String @id @default(uuid()) @db.Uuid
  template_id String @unique @db.Uuid
  device_id   String
  slot        Int
  state       String @default("PENDING")
  error       String?
  synced_at   DateTime? @db.Timestamptz(6)
  template    FingerprintTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  @@unique([device_id, slot])
  @@map("fingerprint_bindings")
}

model FingerprintSession {
  id             String @id @default(uuid()) @db.Uuid
  employee_id    String @db.Uuid
  owner_id       String @db.Uuid
  device_id      String
  finger_name    String
  key            String @db.Uuid
  confirm_key    String? @db.Uuid
  status         String @default("QUEUED")
  match_score    Int?
  ciphertext     Bytes?
  checksum       String?
  template_id    String? @db.Uuid
  error          String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  expires_at     DateTime @db.Timestamptz(6)
  employee       Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  @@unique([owner_id, key])
  @@map("fingerprint_sessions")
}
