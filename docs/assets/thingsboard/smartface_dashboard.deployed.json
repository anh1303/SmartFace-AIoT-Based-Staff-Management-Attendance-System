          "settings": {
            "cardHtml": "<div class=\"sensor-card\">\n  <div class=\"sensor-header\">\n    <div class=\"sensor-title\">\n      <span>📡</span> CẢM BIẾN SIÊU ÂM (HC-SR04)\n    </div>\n    <div class=\"sensor-badge badge-${ai_state}\">\n      ● ${ai_state}\n    </div>\n  </div>\n  \n  <div class=\"sensor-body\">\n    <div class=\"distance-main\">\n      <span class=\"distance-num\">${distance:1}</span>\n      <span class=\"distance-unit\">cm</span>\n    </div>\n    <div class=\"proximity-indicator\">\n      <div class=\"target-zone-label\">\n        <span>0cm</span>\n        <span class=\"threshold-tag\">Vùng Kích Hoạt (&le; 50cm)</span>\n        <span>100cm</span>\n      </div>\n      <div class=\"progress-track\">\n        <div class=\"threshold-marker\" style=\"left: 50%;\"></div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"sensor-footer\">\n    <div class=\"meta-item\">\n      Trạng thái AI: <span class=\"highlight-${ai_state}\">${ai_state}</span>\n    </div>\n    <div class=\"meta-item\">\n      Chốt gửi: <span class=\"latch-status\">${attendance_latch}</span>\n    </div>\n  </div>\n</div>",
            "cardCss": ".sensor-card {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border: 1px solid #334155;\n  border-radius: 12px;\n  padding: 18px 22px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-sizing: border-box;\n  font-family: 'Inter', -apple-system, sans-serif;\n  color: #f8fafc;\n}\n.sensor-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.sensor-title {\n  color: #94a3b8;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.sensor-badge {\n  padding: 4px 10px;\n  border-radius: 20px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.05em;\n}\n.badge-AWAKE {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  border: 1px solid rgba(16, 185, 129, 0.5);\n  box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);\n}\n.badge-SLEEP {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, 0.4);\n}\n.sensor-body {\n  margin: 8px 0;\n  text-align: center;\n}\n.distance-main {\n  display: flex;\n  align-items: baseline;\n  justify-content: center;\n  gap: 6px;\n}\n.distance-num {\n  font-size: 42px;\n  font-weight: 900;\n  color: #38bdf8;\n  letter-spacing: -0.03em;\n  text-shadow: 0 0 25px rgba(56, 189, 248, 0.35);\n  font-variant-numeric: tabular-nums;\n}\n.distance-unit {\n  font-size: 18px;\n  font-weight: 600;\n  color: #94a3b8;\n}\n.proximity-indicator {\n  margin-top: 6px;\n  padding: 0 4px;\n}\n.target-zone-label {\n  display: flex;\n  justify-content: space-between;\n  font-size: 10px;\n  color: #64748b;\n  margin-bottom: 4px;\n}\n.threshold-tag {\n  color: #10b981;\n  font-weight: 700;\n}\n.progress-track {\n  position: relative;\n  width: 100%;\n  height: 6px;\n  background: #334155;\n  border-radius: 4px;\n}\n.threshold-marker {\n  position: absolute;\n  top: -3px;\n  width: 2px;\n  height: 12px;\n  background: #10b981;\n  box-shadow: 0 0 6px #10b981;\n  border-radius: 2px;\n}\n.sensor-footer {\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid #334155;\n  padding-top: 10px;\n  font-size: 11px;\n  color: #64748b;\n}\n.highlight-AWAKE {\n  color: #10b981;\n  font-weight: 700;\n}\n.highlight-SLEEP {\n  color: #94a3b8;\n  font-weight: 600;\n}\n.latch-status {\n  color: #a855f7;\n  font-weight: 700;\n}"
          },
