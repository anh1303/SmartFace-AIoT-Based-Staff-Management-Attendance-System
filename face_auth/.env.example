# ============================================================================
# SmartFace AIoT — Environment Configuration (.env)
# Đồng bộ đầy đủ với config.py và kiến trúc Enterprise V2
# ============================================================================

# 1. Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql://neondb_owner:npg_ZR1cjn6hqUlG@ep-icy-truth-b3077r5c-pooler.c-4.ap-southeast-1.aws.neon.tech/PBL6?sslmode=require

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
APP_DETECTOR=scrfd

# MODEL_CTX_ID: -1 = CPU, >=0 = GPU device index
MODEL_CTX_ID=-1

# 3. Detection Configuration (YunNet / SCRFD)
# APP_DETECTOR:
#   yunnet — siêu nhẹ ~122KB INT8, tối ưu Edge (Pi, Jetson); yêu cầu frame nhỏ (640x480)
#   scrfd  — InsightFace SCRFD, xử lý frame lớn tốt hơn nhưng nặng hơn
APP_DETECTOR=scrfd
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000

# 4. Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Thử resolution mặc định camera; đổi true để revert về 640x480.
CAMERA_FORCE_RESOLUTION=true
CAMERA_FPS=30
CAMERA_BUFFER_SIZE=1

# 5. Anti-Spoofing / PAD (Presentation Attack Detection)
# Bật/tắt module PAD: true / false
PAD_ENABLED=true
# Đường dẫn runtime config JSON, tương đối từ thư mục dự án; để trống để dùng mặc định.
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/smartface_pad_artifacts/E1_v5_1_mnv3/deployment/mnv3_e1_preliminary_v5_1_runtime_config.json
# PAD_RUNTIME_CONFIG_PATH=antispoof/notebooks/final/output/minifasnet_final100k_random_seed100_v2/csmr/runtime_config.json
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_100K_crop15_runtime_config.json
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_FULL_crop15_runtime_config.json
# Optional CASIA TRAIN frame thresholds (minimum ACER/HTER; webcam validation pending).
# Replace the active PAD_RUNTIME_CONFIG_PATH above with ONE matching model line below.
# Mặc định FULL, ngưỡng logit 1.6586914 từ runtime JSON (chưa nghiệm thu webcam).
PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_FULL_crop15_runtime_config_casia.json
# Chuyển 100K bằng dòng dưới, thay dòng active phía trên; không đổi ngưỡng riêng.
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_100K_crop15_runtime_config_casia.json
# Các PAD_* dưới đây có thể để trống để lấy từ runtime config JSON.
PAD_MODEL_FILENAME=
PAD_MODEL_IMG_SIZE=
# Khi PAD_ADAPTIVE_ENABLED=false: threshold env ưu tiên JSON; bật adaptive thì profile thắng env.
# Chỉ nên đặt một biến: PAD_THRESHOLD_LOGIT=0 hoặc PAD_THRESHOLD=0.5 là so trực tiếp 2 logits.
# Nếu đặt cả hai, chúng phải nhất quán: PAD_THRESHOLD = sigmoid(PAD_THRESHOLD_LOGIT).
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=
PAD_COLOR_ORDER=
# Khi adaptive tắt: crop factor env ưu tiên JSON; trống/None dùng JSON. Bật adaptive: profile thắng env.
PAD_BBOX_EXPANSION_FACTOR=
# Crop geometry; runtime JSON takes priority when it contains crop_mode.
PAD_CROP_MODE=minifasnet_train_v1
PAD_GAMMA_ENABLED=
FORCE_GAMMA=false
PAD_MEAN=
PAD_STD=

# Adaptive Gamma Correction (chỉ áp dụng khi runtime config bật gamma)
PAD_GAMMA_TARGET=110.0

# Temporal Smoothing & PAD Gating
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=3
# PAD cadence in seconds; independent of recognition and vote-window size.
PAD_INTERVAL_SECONDS=0.2
PAD_SPOOF_MIN_RATIO=0.6
# Thời gian (giây) trước khi kết quả PAD cũ bị coi là stale (track quay về PAD_PENDING)
PAD_STALE_TIMEOUT_SECONDS=3.0

# 6. Face Tracking & Timing
# Chu kỳ nhận diện lại khuôn mặt (Face Recognition Interval) theo giây
RECOGNIZE_INTERVAL_SECONDS=1.0

# Nhận diện realtime: 1 worker chạy ArcFace + truy vấn cloud, camera không chờ DB.
# Các biến này áp dụng cho app.py; API api_service.py không dùng worker/cache này.
# Pi 4: bắt đầu với queue=2, inference_threads=1; đo thực tế trước khi tăng.

# Số tác vụ chờ tối đa (chưa tính 1 tác vụ đang chạy). Tối thiểu 1.
# Queue đầy: hiện QUEUE FULL và thử gửi lại ở frame sau, không tạo thêm thread.
# Tăng queue để chứa nhiều track hơn, nhưng kết quả có thể phải chờ lâu hơn.
RECOGNITION_QUEUE_SIZE=2

# Số thread ONNX dùng riêng cho ArcFace trong worker, không phải số worker.
# Giữ 1 trên Pi 4 để giảm tranh CPU với detection/PAD; có thể thử 2 và so FPS/độ trễ.
RECOGNITION_INTRA_OP_THREADS=1

# Thời gian dùng centroid đã được cloud xác nhận cho cùng track, đơn vị giây.
# TTL cố định từ lúc nhận centroid; cache hit không gia hạn. 0 = tắt cache.
# Track mới/reset vẫn hỏi cloud. Hết TTL hoặc matching cache thấp sẽ hỏi lại cloud.
# Giảm TTL nếu cần cập nhật nhanh trạng thái nhân viên/embeddings từ cloud.
# Với TTL=30, thay đổi trên cloud có thể chưa được phản ánh trong tối đa 30 giây.
RECOGNITION_CACHE_TTL_SECONDS=30

# Ngưỡng cosine similarity để lưu/dùng cache (0..1), lấy max với MATCH_THRESHOLD.
# 0.65 là giá trị khởi đầu, chưa hiệu chuẩn; không thay đổi MATCH_THRESHOLD của cloud.
# Tăng ngưỡng: ít cache hit, nhiều truy vấn cloud hơn. Mỗi cache hit vẫn chạy ArcFace.
RECOGNITION_CACHE_THRESHOLD=0.65

# Thời gian tối đa chờ lấy connection từ pool, đơn vị giây.
# Cũng dùng để đặt connect_timeout (làm tròn lên, ít nhất 2 giây).
# Tăng nếu cloud thường khởi động chậm; worker có thể chờ lâu hơn, camera vẫn chạy.
RECOGNITION_DB_POOL_TIMEOUT_SECONDS=3

# Giới hạn thời gian thực thi mỗi SQL search ở PostgreSQL, đơn vị mili giây.
# 3000 = 3 giây; không phải deadline tổng gồm queue, DNS, mạng và inference.
# Timeout hiện ERROR rồi retry theo RECOGNIZE_INTERVAL_SECONDS, không coi là UNKNOWN.
RECOGNITION_DB_QUERY_TIMEOUT_MS=3000

# Ổn định nhãn hiển thị; không sửa matching gốc, ngưỡng hay kết quả dùng cho xác minh.
# Tên người khác cần số kết quả liên tiếp này trước khi đổi nhãn. 1 = đổi ngay.
RECOGNITION_LABEL_CONFIRMATIONS=2
# Số kết quả UNKNOWN liên tiếp trước khi bỏ nhãn cũ. Lỗi/PAD mất hiệu lực bỏ ngay.
RECOGNITION_LABEL_UNKNOWN_CONFIRMATIONS=3
# Khi kết quả mới không đồng ý, giữ nhãn cũ tối đa số giây này, ghi LAST LABEL.
# Không gia hạn bởi các kết quả bất đồng mới; 0 = không giữ nhãn bất đồng.
RECOGNITION_LABEL_HOLD_SECONDS=1.5

# Overlay: WAIT <giây>, QUEUE FULL, CLOUD/CACHE <độ trễ tổng>, ERROR <loại lỗi>.
# Kết quả muộn chỉ áp dụng khi track/PAD còn hợp lệ trong cùng phiên xác minh.
# Sau khi sửa .env, khởi động lại app.py để nhận cấu hình mới.
# Hướng dẫn/test Pi: md/REALTIME_RECOGNITION_WORKER.md
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10
# 0 = detector mỗi frame; mặc định code dùng PAD cadence (0.2s)
DETECTION_INTERVAL_SECONDS=0.2
PAD_DIAGNOSTIC_LOG=false
# Thử nghiệm ổn định crop PAD; false để về baseline.
PAD_CROP_SMOOTHING=false

# 7. Attendance Tracking (Điểm danh)
# Chế độ: checkin | checkout | none
ATTENDANCE_MODE=none
# Giãn cách tối thiểu (phút) giữa 2 lần điểm danh liên tiếp của cùng 1 người
ATTENDANCE_GAP_MINUTES=15
# Số lượt recognition liên tiếp khớp cùng người để ghi check-in/out, không đếm frame/detect/PAD.
# Hiển thị tên ngay từ lượt recognition khớp đầu tiên.
ATTENDANCE_STABLE_COUNT=3
# Ngưỡng cosine similarity chấp nhận danh tính (LFW benchmark calibrated)
MATCH_THRESHOLD=0.35

# 8. Enrollment Configuration
RECOMMENDED_GALLERY_SIZE=3

# 9. UI Display & Overlay
SHOW_FPS=true
FPS_AVG_WINDOW=30

PAD_MIN_DETECTOR_CONFIDENCE=0.5

# Check-in/out yêu cầu >=3 lượt recognition khớp cùng người liên tiếp; khác với ổn định nhãn UI.

# Số mặt tối đa qua tracking/PAD/recognition; ưu tiên mặt lớn nhất, yêu cầu >=1.
MAX_FACES_PER_FRAME=3

# Thử profile camera local80 (gamma LUT + adaptive threshold); thay dòng active khi muốn dùng:
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_FULL_local98_shadow_runtime.json

# Bật: profile adaptive ưu tiên cao hơn threshold/crop/FORCE_GAMMA trong env.
# Tắt: dùng runtime JSON và override env. Mặc định bật profile balanced để test camera.
PAD_ADAPTIVE_ENABLED=true
PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_all1136_balanced_runtime.json
# Profile cũ để đối chiếu:
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_local98_shadow_runtime.json
# Test local100: crop 1.45, 0 fake lọt / 3 real bị chặn trên tập hiệu chỉnh (không có holdout).
# Giữ PAD_ADAPTIVE_ENABLED=true; comment dòng path phía trên và bỏ comment dòng dưới để thử.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_local100_fixedcrop_robust_runtime.json

# Test local842 (ảnh camera thực tế đã làm sạch; chưa có holdout).
# Bật PAD_ADAPTIVE_ENABLED=true, comment path đang dùng rồi bật một path bên dưới.
# Ưu tiên ít fake: 0/237 fake lọt, 35/605 real bị chặn, crop 1.20.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_local842_real_runtime.json
# Ưu tiên nhận real: 2/237 fake lọt, 16/605 real bị chặn, crop 1.10.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_local842_balanced_runtime.json

# Profile vòng 1 để đối chiếu; kết quả crop rộng bên dưới chỉ trên subset 682 ảnh.
# Bật PAD_ADAPTIVE_ENABLED=true, comment path đang dùng và chọn một path dưới.
# Crop1.70: 0 fake/28 real bị chặn trên 426real+256fake có frame gốc; không còn là lựa chọn khuyến nghị.
# Batch Pi mới hợp lệ40real+254fake: 0 fake lọt, 0 real bị chặn (số liệu hiệu chỉnh).
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_final_conservative_runtime.json
# Ưu tiên nhận real: crop2.20, 1 fake/1 real bị chặn trên cùng682ảnh; Pi mới0/0.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_final_balanced_runtime.json
# Phương án crop nhỏ, kiểm tra đủ1136ảnh (645real+491fake): 0 fake/76 real bị chặn; Pi mới0/1.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_final_common_runtime.json
# Các profile vẫn nhạy với bbox/nén ảnh; cần test video/camera thực tế trước khi triển khai rộng.

# PAD FINAL vòng 2: đủ 1136 ảnh hợp lệ; thay thế lựa chọn pi_final_* (682 ảnh).
# Bật PAD_ADAPTIVE_ENABLED=true; comment path đang dùng, chọn đúng một path dưới.
# balanced: crop 1.1; fake lọt 2/491, real bị chặn 49/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_all1136_balanced_runtime.json
# strict: crop 1.2; fake lọt 0/491, real bị chặn 76/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_all1136_strict_runtime.json
# real: crop 1.2; fake lọt 4/491, real bị chặn 31/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_all1136_real_runtime.json
