# ============================================================================
# SmartFace AIoT — Environment Configuration Example (.env.example)
# Sao chép file này thành .env và điền các giá trị cấu hình tương ứng.
# ============================================================================

# 1. Database Connection (PostgreSQL + pgvector)
# Cách 1: Connection string URL (Supabase, Neon, AWS RDS, ...)
DATABASE_URL=

# Cách 2: Chi tiết từng thông số kết nối (Local Docker hoặc Server)
POSTGRES_DB=face_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cấu hình Connection Pool (psycopg_pool)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# 2. Recognition Model (InsightFace ArcFace)
MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
# MODEL_CTX_ID: -1 = CPU, >=0 = GPU device index
MODEL_CTX_ID=-1

# 3. Detection Model (YunNet / SCRFD)
# APP_DETECTOR: "yunnet" (edge-first, nhẹ) hoặc "scrfd" (InsightFace, ảnh lớn)
APP_DETECTOR=scrfd
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000

# 4. Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
# Hàng đợi frame camera; 1 giảm độ trễ, backend có thể bỏ qua thuộc tính này.
CAMERA_BUFFER_SIZE=1

# 5. Anti-Spoofing / PAD (Presentation Attack Detection)
PAD_ENABLED=true
# Optional JSON runtime config; a relative path is resolved from the project root.
# Leave blank to use PAD_* values below and config.py defaults.
PAD_RUNTIME_CONFIG_PATH=
# Explicit PAD_* values override matching fields from the runtime JSON; blank uses JSON/defaults.
PAD_MODEL_FILENAME=
PAD_MODEL_IMG_SIZE=
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=
# PAD_COLOR_ORDER: BGR, RGB, or blank (auto-detect when not set by JSON)
PAD_COLOR_ORDER=
PAD_BBOX_EXPANSION_FACTOR=
PAD_GAMMA_ENABLED=
PAD_MEAN=
PAD_STD=
PAD_GAMMA_TARGET=110.0
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=5
PAD_SPOOF_MIN_RATIO=0.6
PAD_STALE_TIMEOUT_SECONDS=3.0

# 6. Face Tracking & Timing
# Chu kỳ nhận diện lại (giây)
RECOGNIZE_INTERVAL_SECONDS=0.5
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10
# 0 = detector every frame; default follows PAD interval
DETECTION_INTERVAL_SECONDS=0.1
PAD_DIAGNOSTIC_LOG=false

# 7. Attendance Tracking
# Chế độ: checkin | checkout | none
ATTENDANCE_MODE=checkin
ATTENDANCE_GAP_MINUTES=15
ATTENDANCE_STABLE_COUNT=3
MATCH_THRESHOLD=0.35

# 8. Enrollment Configuration
RECOMMENDED_GALLERY_SIZE=3

# 9. UI Display
SHOW_FPS=true
FPS_AVG_WINDOW=30

# 10. Integration Tests (Chỉ bật khi chạy live DB integration tests với test database riêng biệt)
RUN_DB_INTEGRATION_TESTS=0
TEST_DATABASE_URL=
