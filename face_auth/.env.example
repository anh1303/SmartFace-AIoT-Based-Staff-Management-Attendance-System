# ============================================================================
# SmartFace AIoT — Environment Configuration (.env)
# Đồng bộ đầy đủ với config.py và kiến trúc Enterprise V2
# ============================================================================

# 1. Database Connection (PostgreSQL + pgvector)
# Cách 1: Dùng URL kết nối chung (Cloud DB như Supabase, Neon, AWS RDS, ...)
# Ví dụ: DATABASE_URL=postgresql://username:password@host:port/dbname
DATABASE_URL=

# Cách 2: Cấu hình từng thành phần (Local DB / Docker — áp dụng nếu DATABASE_URL trống)
POSTGRES_DB=face_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection Pool (psycopg_pool)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# 2. Recognition Model (InsightFace ArcFace)
MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
# MODEL_CTX_ID: -1 = CPU, >=0 = GPU device index
MODEL_CTX_ID=-1

# 3. Detection Configuration (YunNet / SCRFD)
# APP_DETECTOR:
#   yunnet — siêu nhẹ ~122KB INT8, tối ưu Edge (Pi, Jetson); yêu cầu frame nhỏ (640x480)
#   scrfd  — InsightFace SCRFD, xử lý frame lớn tốt hơn nhưng nặng hơn
APP_DETECTOR=scrfd
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000

# 4. Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
# Thử resolution mặc định camera; đổi true để revert về 640x480.
CAMERA_FORCE_RESOLUTION=true
CAMERA_FPS=30
CAMERA_BUFFER_SIZE=1

# 5. Anti-Spoofing / PAD (Presentation Attack Detection)
# Bật/tắt module PAD: true / false
PAD_ENABLED=true
# Đường dẫn runtime config JSON, tương đối từ thư mục dự án; để trống để dùng mặc định.
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/smartface_pad_artifacts/E1_v5_1_mnv3/deployment/mnv3_e1_preliminary_v5_1_runtime_config.json
PAD_RUNTIME_CONFIG_PATH=antispoof/notebooks/final/output/minifasnet_final100k_random_seed100_v2/csmr/runtime_config.json
# PAD_RUNTIME_CONFIG_PATH=antispoof/notebooks/final/output/minifasnet_final100k_pretrained_seed100_v2/csmr/runtime_config.json
# PAD_RUNTIME_CONFIG_PATH=antispoof/models/smartface_pad_artifacts/E1_v5_3_mnv3_small/deployment/mnv3s_e1_preliminary_v5_3_edge_runtime_config.json
# Các PAD_* dưới đây có thể để trống để lấy từ runtime config JSON.
PAD_MODEL_FILENAME=
PAD_MODEL_IMG_SIZE=
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=
PAD_COLOR_ORDER=
PAD_BBOX_EXPANSION_FACTOR=
# Crop geometry; runtime JSON takes priority when it contains crop_mode.
PAD_CROP_MODE=minifasnet_train_v1
PAD_GAMMA_ENABLED=
PAD_MEAN=
PAD_STD=

# Adaptive Gamma Correction (chỉ áp dụng khi runtime config bật gamma)
PAD_GAMMA_TARGET=110.0

# Temporal Smoothing & PAD Gating
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=5
# Blank derives from recognition cadence divided by PAD_SMOOTH_WINDOW.
PAD_INTERVAL_SECONDS=
PAD_SPOOF_MIN_RATIO=0.6
# Thời gian (giây) trước khi kết quả PAD cũ bị coi là stale (track quay về PAD_PENDING)
PAD_STALE_TIMEOUT_SECONDS=3.0

# 6. Face Tracking & Timing
# Chu kỳ nhận diện lại khuôn mặt (Face Recognition Interval) theo giây
RECOGNIZE_INTERVAL_SECONDS=0.5
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10
# 0 = detector mỗi frame; mặc định code dùng PAD cadence (0.1s)
DETECTION_INTERVAL_SECONDS=0.1
PAD_DIAGNOSTIC_LOG=false
# Thử nghiệm ổn định crop PAD; false để về baseline.
PAD_CROP_SMOOTHING=true

# 7. Attendance Tracking (Điểm danh)
# Chế độ: checkin | checkout | none
ATTENDANCE_MODE=none
# Giãn cách tối thiểu (phút) giữa 2 lần điểm danh liên tiếp của cùng 1 người
ATTENDANCE_GAP_MINUTES=15
# Số lần nhận diện ổn định liên tiếp trước khi ghi nhận điểm danh
ATTENDANCE_STABLE_COUNT=2
# Ngưỡng cosine similarity chấp nhận danh tính (LFW benchmark calibrated)
MATCH_THRESHOLD=0.35

# 8. Enrollment Configuration
RECOMMENDED_GALLERY_SIZE=3

# 9. UI Display & Overlay
SHOW_FPS=true
FPS_AVG_WINDOW=30
