# Sao chép thành face_auth/.env; cấu hình chạy Python trực tiếp từ face_auth/.
# Docker dùng env_file và có thể ghi đè bằng environment trong Compose.
# Không dùng số liệu hiệu chỉnh trong ghi chú cũ làm chứng nhận webcam/holdout.

# Database cùng backend; Neon thêm sslmode=require theo endpoint.
# psycopg không nhận tham số schema=public của Prisma; không sao chép URL đó nguyên xi.
DATABASE_URL=postgresql://postgres:change-me-local-db-password@127.0.0.1:5432/PBL6
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_MS=5000

# Cùng key >=32 ký tự với backend; thay chuỗi change-me. Face login mặc định tắt.
FACE_AUTH_INTERNAL_KEY=change-me-internal-key-at-least-32-characters
FACE_LOGIN_ENABLED=false

# Embedding version phải khớp backend và vector đã đăng ký. -1 = CPU.
MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
MODEL_CTX_ID=-1
APP_DETECTOR=scrfd

# Detector; giữ cấu hình hiện có. DETECTOR_MODEL_PATH chỉ cần khi dùng model tùy chọn.
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000
PAD_MIN_DETECTOR_CONFIDENCE=0.5

# Camera cho app.py; API không tự mở camera.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FORCE_RESOLUTION=true
CAMERA_FPS=30
CAMERA_BUFFER_SIZE=1

# Đường dẫn tương đối từ face_auth/. Giữ nguyên model/profile đang có trong mẫu.
PAD_ENABLED=true
PAD_RUNTIME_CONFIG_PATH=antispoof/models/R7_SC_FULL_crop15_runtime_config_casia.json
PAD_ADAPTIVE_ENABLED=true
PAD_ADAPTIVE_CONFIG_PATH=antispoof/models/R7_SC_FULL_pi_final_conservative_runtime.json

# Adaptive bật: profile quyết định contract. Adaptive tắt: override env theo config.py.
# Để trống để lấy JSON/default; không nhập đồng thời hai threshold không nhất quán.
PAD_MODEL_FILENAME=
PAD_MODEL_IMG_SIZE=
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=
PAD_COLOR_ORDER=
PAD_BBOX_EXPANSION_FACTOR=
PAD_CROP_MODE=minifasnet_train_v1
PAD_GAMMA_ENABLED=
FORCE_GAMMA=false
PAD_MEAN=
PAD_STD=
PAD_GAMMA_TARGET=110.0

# PAD/tracking; cadence tính bằng giây, không đồng nhất votes với recognition.
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=3
PAD_INTERVAL_SECONDS=0.2
PAD_SPOOF_MIN_RATIO=0.6
PAD_STALE_TIMEOUT_SECONDS=3.0
PAD_DIAGNOSTIC_LOG=false
PAD_CROP_SMOOTHING=false
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10
DETECTION_INTERVAL_SECONDS=0.2
MAX_FACES_PER_FRAME=3

# Worker nhận diện của app.py; API dùng DB_POOL_* ở trên.
RECOGNIZE_INTERVAL_SECONDS=1.0
RECOGNITION_QUEUE_SIZE=2
RECOGNITION_INTRA_OP_THREADS=1
RECOGNITION_CACHE_TTL_SECONDS=30
RECOGNITION_CACHE_THRESHOLD=0.65
RECOGNITION_DB_POOL_TIMEOUT_SECONDS=3
RECOGNITION_DB_QUERY_TIMEOUT_MS=3000
RECOGNITION_LABEL_CONFIRMATIONS=2
RECOGNITION_LABEL_UNKNOWN_CONFIRMATIONS=3
RECOGNITION_LABEL_HOLD_SECONDS=1.5
MATCH_THRESHOLD=0.35

# App demo không ghi attendance trực tiếp; backend sở hữu công/lương.
# STABLE_COUNT khớp backend/Pi; không phải PAD_MIN_VOTES.
ATTENDANCE_MODE=none
ATTENDANCE_GAP_MINUTES=15
ATTENDANCE_STABLE_COUNT=1
RECOMMENDED_GALLERY_SIZE=3

# Hiển thị của app.py.
SHOW_FPS=true
FPS_AVG_WINDOW=30
