# MODULE FACE_AUTH: QUẢN LÝ DỮ LIỆU ẢNH, DATASET & ARTIFACTS
# (Các ignore hệ thống như OS, IDE, .env, Python bytecode được quản lý ở root .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GALLERY: Thư mục chứa ảnh khuôn mặt đăng ký (User Gallery)
# ------------------------------------------------------------------------------
gallery/
/gallery/

# ------------------------------------------------------------------------------
# 2. DATA: Thư mục chứa dataset ảnh LFW & Metadata tải về
# ------------------------------------------------------------------------------
data/lfw/
/data/lfw/
data/lfw_metadata/
/data/lfw_metadata/

# Bỏ qua các file nén dataset tải về
data/*.zip
data/*.tar.gz
data/*.tgz

# Bỏ qua toàn bộ dữ liệu khác trong data/, CHỈ GIỮ LẠI tài liệu hướng dẫn
data/*
/data/*
!data/data_readme.md
!/data/data_readme.md
!data/.gitkeep
!/data/.gitkeep

# ------------------------------------------------------------------------------
# 3. EVALUATION: Bỏ qua tất cả thư mục chứa ảnh test / impostors
# ------------------------------------------------------------------------------
evaluation/lfw_demo_impostors/
/evaluation/lfw_demo_impostors/
evaluation/lfw_demo_test_images/
/evaluation/lfw_demo_test_images/
evaluation/**/images/
/evaluation/**/images/

# Bỏ qua mọi định dạng file ảnh phát sinh trong thư mục evaluation (giữ lại code, notebook, manifest)
evaluation/**/*.jpg
evaluation/**/*.jpeg
evaluation/**/*.png
evaluation/**/*.webp
evaluation/**/*.bmp
/evaluation/**/*.jpg
/evaluation/**/*.jpeg
/evaluation/**/*.png
/evaluation/**/*.webp
/evaluation/**/*.bmp

# ------------------------------------------------------------------------------
# 4. BENCHMARK & EMBEDDING CACHE: Bỏ qua cache sinh ra từ benchmark notebook
# ------------------------------------------------------------------------------
benchmark/
/benchmark/
benchmark_cache/
*.npy
*.npz
