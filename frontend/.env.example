# Sao chép thành frontend/.env. VITE_* là cấu hình công khai lúc build, không chứa secret.
# Chạy npm run dev: Vite proxy /api và /socket.io tới http://127.0.0.1:3000.
# Cùng origin sau Nginx/Caddy: giữ hai URL trống. URL API là origin, không thêm /api.
VITE_API_BASE=
VITE_SOCKET_URL=

# Dùng backend thật; demo chỉ bật khi chủ động xem dữ liệu giả.
VITE_DEMO_MODE=false
# false cho stack Phase 1 không có Pi/ThingsBoard; true cho giao diện AIoT.
VITE_IOT_HARDWARE_ENABLED=true

# Trống: tự chọn /camera/pi4_cam/whep trên HTTPS hoặc cổng 8889 trên HTTP.
# HTTPS cần proxy camera phù hợp; không trỏ về HTTP để tránh Mixed Content.
VITE_MEDIAMTX_WHEP_URL=

# Thay file này không cập nhật bundle đã build. Docker Phase 1 nhận cờ phần cứng
# qua build arg PHASE1_IOT_HARDWARE_ENABLED trong .env.phase1.*.
