# VITE_API_BASE: Base API URL (de trong "" de dung Vite proxy /api den backend http://localhost:3000)
VITE_API_BASE=""

# VITE_SOCKET_URL: Backend Socket.IO server URL for real-time attendance & device events
# For a deployment behind the same-origin proxy, leave this empty: "".
# Vite env values are embedded at build time. The current Docker build excludes
# .env* files and uses the same-origin defaults; editing .env alone does not
# configure an already-built frontend image.
VITE_SOCKET_URL="http://localhost:3000"

# Development demo only; keep false for the real backend.
VITE_DEMO_MODE=false
