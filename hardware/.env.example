# ============================================================================
# CẤU HÌNH SMARTFACE EDGE CLIENT (RASPBERRY PI 4) - TEMPLATE
# ============================================================================

# 1. Định danh thiết bị
DEVICE_ID=PI4_FRONT_GATE
INITIAL_MODE=CHECK_IN

# 2. Kết nối ThingsBoard Server (Địa chỉ IP LAN của máy Server chạy Docker)
TB_HOST=10.134.27.36
TB_PORT=1883
TB_TOKEN=ivu62ZoR6gkXyqqoDobJ

# 3. Live Stream RTSP về MediaMTX Server
STREAM_ENABLED=true
RTSP_URL=rtsp://10.134.27.36:8554/pi4_cam
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# 4. Tham số AI & Chống Spam
# Chọn mô hình phát hiện khuôn mặt: 'scrfd' (chính xác cao, mặc định) hoặc 'yunnet' (siêu nhẹ cho Pi)
APP_DETECTOR=scrfd

SCAN_COOLDOWN_SECONDS=5.0

# 5. Tham số Tracking (IOU + Optical Flow Cadence)
# Chu kỳ detector độc lập với PAD và recognition.
DETECTION_INTERVAL_SECONDS=0.2
PAD_INTERVAL_SECONDS=0.2
RECOGNIZE_INTERVAL_SECONDS=1.0
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10

# Giới hạn số lượng khuôn mặt lớn nhất được theo dõi & xử lý trên 1 frame
# Số nguyên >=1; ưu tiên khuôn mặt lớn nhất (gần camera nhất).
MAX_FACES_PER_FRAME=3

# 6. Hiển thị cửa sổ tại chỗ (false: mặc định cho Raspberry Pi chạy ngầm/headless; true: mở cửa sổ OpenCV khi test trên máy tính có màn hình)
SHOW_GUI=false
# FPS trung bình in ở terminal mỗi 10 giây, không vẽ lên video/TFT.
SHOW_FPS=true

# ============================================================================
# 7. Màn hình phần cứng TFT ST7789V SPI (240x320) trên Raspberry Pi
# ============================================================================
TFT_ENABLED=true
TFT_WIDTH=320
TFT_HEIGHT=240
TFT_ROTATE=0
TFT_SPI_MHZ=32
TFT_DC_PIN=25
TFT_RESET_PIN=24
TFT_BGR=false
TFT_INVERT=false
# Worker TFT riêng, tối đa 10 FPS; có thể đặt 5 để giảm tải thêm.
TFT_DISPLAY_FPS=10

# ============================================================================
# 8. Cảm biến siêu âm Wake-on-Presence (Tiết kiệm CPU & Chống Spam)
# ============================================================================
# Bật/tắt cảm biến siêu âm (true: kích hoạt cơ chế ngủ/thức; false: AI chạy liên tục)
ULTRASONIC_ENABLED=true
# Chân GPIO BCM (TRIG pin 16 = GPIO 23, ECHO pin 13 = GPIO 27 qua cầu phân áp)
ULTRASONIC_TRIG_PIN=23
ULTRASONIC_ECHO_PIN=27
# Cự ly kích hoạt AI thức dậy (cm)
ULTRASONIC_TRIGGER_DISTANCE=50.0
# Cự ly tối đa hợp lệ (cm, lớn hơn 100cm coi là không có người)
ULTRASONIC_MAX_DISTANCE=100.0
# Thời gian đệm giữ trạng thái thức khi người vừa rời đi (giây)
ULTRASONIC_SLEEP_DELAY=5.0
# Thời gian mất dấu khuôn mặt để mở khóa đón người tiếp theo (giây)
FACE_LOST_RESET_SECONDS=1.5

# Optional direct mode notification; normally leave blank and use TB Mode Relay.
BACKEND_BASE_URL=
TB_WEBHOOK_SECRET=

MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
MODEL_CTX_ID=-1
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000
CAMERA_FORCE_RESOLUTION=true
CAMERA_BUFFER_SIZE=1
PAD_MIN_DETECTOR_CONFIDENCE=0.5
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=3
PAD_SPOOF_MIN_RATIO=0.6
PAD_STALE_TIMEOUT_SECONDS=3.0
PAD_DIAGNOSTIC_LOG=false
PAD_CROP_SMOOTHING=false
PAD_CROP_MODE=minifasnet_train_v1
RECOGNITION_QUEUE_SIZE=2
RECOGNITION_INTRA_OP_THREADS=1
RECOGNITION_CACHE_TTL_SECONDS=30
RECOGNITION_CACHE_THRESHOLD=0.65
RECOGNITION_LABEL_CONFIRMATIONS=2
RECOGNITION_LABEL_UNKNOWN_CONFIRMATIONS=3
RECOGNITION_LABEL_HOLD_SECONDS=1.5
MATCH_THRESHOLD=0.35

# Runtime JSON quyết định model/hash/crop/màu và ngưỡng mặc định; override threshold riêng bên dưới.
PAD_RUNTIME_CONFIG_PATH=models/R7_SC_FULL_crop15_runtime_config_casia.json
# Chuyển 100K: models/R7_SC_100K_crop15_runtime_config_casia.json

# Khi PAD_ADAPTIVE_ENABLED=false: threshold env ưu tiên JSON; bật adaptive thì profile thắng env.
# Chỉ nên đặt một biến: PAD_THRESHOLD_LOGIT=0 hoặc PAD_THRESHOLD=0.5 là so trực tiếp 2 logits.
# Nếu đặt cả hai, chúng phải nhất quán: PAD_THRESHOLD = sigmoid(PAD_THRESHOLD_LOGIT).
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=

# Số lượt recognition liên tiếp khớp cùng người để ghi check-in/out, không đếm frame/detect/PAD.
# Hiển thị tên ngay từ lượt recognition khớp đầu tiên.
ATTENDANCE_STABLE_COUNT=2

# Khi adaptive tắt: crop factor env ưu tiên JSON; trống/None dùng JSON. Bật adaptive: profile thắng env.
PAD_BBOX_EXPANSION_FACTOR=

# Thử profile camera local80 (gamma LUT + adaptive threshold); thay dòng active khi muốn dùng:
# PAD_RUNTIME_CONFIG_PATH=models/R7_SC_FULL_local98_shadow_runtime.json

# Bật: profile adaptive ưu tiên cao hơn threshold/crop/FORCE_GAMMA trong env.
# Tắt: dùng runtime JSON và override env. Mặc định bật profile balanced để test camera.
PAD_ADAPTIVE_ENABLED=true
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_all1136_balanced_runtime.json
# Profile cũ để đối chiếu:
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_local98_shadow_runtime.json
# Test local100: crop 1.45, 0 fake lọt / 3 real bị chặn trên tập hiệu chỉnh (không có holdout).
# Giữ PAD_ADAPTIVE_ENABLED=true; comment dòng path phía trên và bỏ comment dòng dưới để thử.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_local100_fixedcrop_robust_runtime.json

# Test local842 (ảnh camera thực tế đã làm sạch; chưa có holdout).
# Bật PAD_ADAPTIVE_ENABLED=true, comment path đang dùng rồi bật một path bên dưới.
# Ưu tiên ít fake: 0/237 fake lọt, 35/605 real bị chặn, crop 1.20.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_local842_real_runtime.json
# Ưu tiên nhận real: 2/237 fake lọt, 16/605 real bị chặn, crop 1.10.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_local842_balanced_runtime.json

# Profile vòng 1 để đối chiếu; kết quả crop rộng bên dưới chỉ trên subset 682 ảnh.
# Bật PAD_ADAPTIVE_ENABLED=true, comment path đang dùng và chọn một path dưới.
# Crop1.70: 0 fake/28 real bị chặn trên 426real+256fake có frame gốc; không còn là lựa chọn khuyến nghị.
# Batch Pi mới hợp lệ40real+254fake: 0 fake lọt, 0 real bị chặn (số liệu hiệu chỉnh).
PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_final_conservative_runtime.json
# Ưu tiên nhận real: crop2.20, 1 fake/1 real bị chặn trên cùng682ảnh; Pi mới0/0.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_final_balanced_runtime.json
# Phương án crop nhỏ, kiểm tra đủ1136ảnh (645real+491fake): 0 fake/76 real bị chặn; Pi mới0/1.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_final_common_runtime.json
# Các profile vẫn nhạy với bbox/nén ảnh; cần test video/camera thực tế trước khi triển khai rộng.

# PAD FINAL vòng 2: đủ 1136 ảnh hợp lệ; thay thế lựa chọn pi_final_* (682 ảnh).
# Bật PAD_ADAPTIVE_ENABLED=true; comment path đang dùng, chọn đúng một path dưới.
# balanced: crop 1.1; fake lọt 2/491, real bị chặn 49/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_all1136_balanced_runtime.json
# strict: crop 1.2; fake lọt 0/491, real bị chặn 76/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_all1136_strict_runtime.json
# real: crop 1.2; fake lọt 4/491, real bị chặn 31/645; calibrated, không holdout.
# PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_all1136_real_runtime.json
