# Sao chép thành hardware/.env trên Pi; thay IP/token mẫu theo server thực tế.
# Cổng MQTT/RTSP dùng LAN hoặc VPN. Tài liệu: hardware/README.md và RUN_ON_PI.md.
# Giữ nguyên model/profile, cadence, GPIO và hiệu chỉnh hiện có của mẫu.

# Thiết bị và ThingsBoard. TB_TOKEN lấy từ device credentials, không dùng token mẫu.
DEVICE_ID=PI4_FRONT_GATE
INITIAL_MODE=AUTO
TB_HOST=192.168.1.50
TB_PORT=1883
TB_TOKEN=

# Direct attendance cần origin backend và token riêng >=32 ký tự, không có khoảng trắng.
# Token khớp EDGE_RECOGNITION_KEYS[DEVICE_ID] ở backend. Không dùng FACE_AUTH_INTERNAL_KEY.
# TB_WEBHOOK_SECRET chỉ cần nếu dùng thông báo mode trực tiếp/luồng webhook.
BACKEND_BASE_URL=https://smartface.example.com
EDGE_RECOGNITION_TOKEN=change-me-device-token-at-least-32-characters
TB_WEBHOOK_SECRET=
ATTENDANCE_TRANSPORT=direct
ATTENDANCE_HTTP_TIMEOUT_SECONDS=8
ATTENDANCE_STABLE_COUNT=1
SCAN_COOLDOWN_SECONDS=5.0

# Stream tới MediaMTX, không phải URL trang frontend.
STREAM_ENABLED=true
RTSP_URL=rtsp://192.168.1.50:8554/pi4_cam

# Camera và detector; -1 = CPU. Embedding version phải khớp backend.
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_FORCE_RESOLUTION=true
CAMERA_BUFFER_SIZE=1
MODEL_PACK_NAME=buffalo_s
EMBEDDING_MODEL_VERSION=buffalo_s
MODEL_CTX_ID=-1
APP_DETECTOR=scrfd
DETECTOR_MIN_FACE_SIZE=60
DETECTOR_MARGIN=5
DETECTOR_CONF_THRESH=0.5
DETECTOR_NMS_THRESH=0.3
DETECTOR_TOP_K=5000
PAD_MIN_DETECTOR_CONFIDENCE=0.5

# Đường dẫn tương đối từ hardware/. Giữ model/profile hiện có, không suy ra nghiệm thu.
PAD_RUNTIME_CONFIG_PATH=models/R7_SC_FULL_crop15_runtime_config_casia.json
PAD_ADAPTIVE_ENABLED=true
PAD_ADAPTIVE_CONFIG_PATH=models/R7_SC_FULL_pi_final_conservative_runtime.json

# Adaptive bật: profile ưu tiên. Tắt: runtime JSON và override theo config.py.
# Threshold/crop trống dùng contract; không đặt hai threshold mâu thuẫn nhau.
PAD_THRESHOLD=
PAD_THRESHOLD_LOGIT=
PAD_BBOX_EXPANSION_FACTOR=
PAD_CROP_MODE=minifasnet_train_v1
PAD_CROP_SMOOTHING=false
PAD_SMOOTH_WINDOW=5
PAD_MIN_VOTES=3
PAD_SPOOF_MIN_RATIO=0.6
PAD_STALE_TIMEOUT_SECONDS=3.0
PAD_DIAGNOSTIC_LOG=false

# Cadence giây và tracking; recognition count khác PAD votes.
DETECTION_INTERVAL_SECONDS=0.2
PAD_INTERVAL_SECONDS=0.2
RECOGNIZE_INTERVAL_SECONDS=1.0
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10
MAX_FACES_PER_FRAME=3

# Nhận diện cục bộ mặc định. server cần bật REMOTE_RECOGNITION_ENABLED ở backend.
# SHA256 phải khớp ArcFace server; không thay bằng hash của model PAD.
RECOGNITION_BACKEND=local
REMOTE_RECOGNITION_TIMEOUT_SECONDS=3
REMOTE_ARCFACE_SHA256=9cc6e4a75f0e2bf0b1aed94578f144d15175f357bdc05e815e5c4a02b319eb4f
MATCH_THRESHOLD=0.35
RECOGNITION_QUEUE_SIZE=2
RECOGNITION_INTRA_OP_THREADS=1
RECOGNITION_CACHE_TTL_SECONDS=30
RECOGNITION_CACHE_THRESHOLD=0.65
RECOGNITION_LABEL_CONFIRMATIONS=2
RECOGNITION_LABEL_UNKNOWN_CONFIRMATIONS=3
RECOGNITION_LABEL_HOLD_SECONDS=1.5

# GUI và TFT. Chỉ bật ngoại vi tương ứng phần cứng đã đấu đúng.
SHOW_GUI=false
SHOW_FPS=true
TFT_ENABLED=true
TFT_WIDTH=320
TFT_HEIGHT=240
TFT_ROTATE=0
TFT_SPI_MHZ=32
TFT_DC_PIN=25
TFT_RESET_PIN=24
TFT_BGR=false
TFT_INVERT=false
TFT_DISPLAY_FPS=10

# HC-SR04; ECHO phải qua chuyển mức/phân áp phù hợp trước GPIO 3.3V.
ULTRASONIC_ENABLED=true
ULTRASONIC_TRIG_PIN=23
ULTRASONIC_ECHO_PIN=27
ULTRASONIC_TRIGGER_DISTANCE=50.0
ULTRASONIC_DEBOUNCE_SECONDS=0.5
ULTRASONIC_MAX_DISTANCE=150.0
ULTRASONIC_SLEEP_DELAY=0.5
FACE_LOST_RESET_SECONDS=1.5

# Servo: arduino dùng firmware/serial; gpio dùng SERVO_PIN.
SERVO_ENABLED=true
SERVO_BACKEND=arduino
SERVO_ARDUINO_PORT=/dev/ttyACM0
SERVO_PIN=18
SERVO_OPEN_SECONDS=3.0
SERVO_TRAVEL_SECONDS=2.0

# Vân tay mặc định tắt; dùng BACKEND_BASE_URL và token thiết bị ở trên.
FINGERPRINT_ENABLED=false
FINGERPRINT_PORT=/dev/serial0
FINGERPRINT_BAUD=57600
FINGERPRINT_TOUCH_PIN=17
