# ============================================================================
# CẤU HÌNH SMARTFACE EDGE CLIENT (RASPBERRY PI 4) - TEMPLATE
# ============================================================================

# 1. Định danh thiết bị
DEVICE_ID=PI4_FRONT_GATE
INITIAL_MODE=CHECK_IN

# 2. Kết nối ThingsBoard Server (Địa chỉ IP LAN của máy Server chạy Docker)
TB_HOST=192.168.1.50
TB_PORT=1883
TB_TOKEN=

# 3. Live Stream RTSP về MediaMTX Server
STREAM_ENABLED=true
RTSP_URL=rtsp://192.168.1.50:8554/pi4_cam
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# 4. Tham số AI & Chống Spam
# Chọn mô hình phát hiện khuôn mặt: 'scrfd' (chính xác cao, mặc định) hoặc 'yunnet' (siêu nhẹ cho Pi)
APP_DETECTOR=scrfd

# Ngưỡng logit phân định Real/Spoof cho MiniFASNet R7 (-4.2998 theo chuẩn CASIA)
FAS_LOGIT_THRESHOLD=-4.2998
CONSECUTIVE_REAL_FRAMES=3
SCAN_COOLDOWN_SECONDS=5.0

# 5. Tham số Tracking (IOU + Optical Flow Cadence)
# Chu kỳ chạy Detector (giây). 0.2s giúp giảm >50% CPU cho Raspberry Pi 4 mà vẫn bắt kịp chuyển động
DETECTION_INTERVAL_SECONDS=0.2
PAD_INTERVAL_SECONDS=0.2
RECOGNIZE_INTERVAL_SECONDS=1.0
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_MISSING_FRAMES=10

# Giới hạn số lượng khuôn mặt lớn nhất được theo dõi & xử lý trên 1 frame
# (1: tối ưu cho cổng điểm danh ưu tiên người gần nhất; 0: không giới hạn)
MAX_FACES_PER_FRAME=1

# 6. Hiển thị cửa sổ tại chỗ (false: mặc định cho Raspberry Pi chạy ngầm/headless; true: mở cửa sổ OpenCV khi test trên máy tính có màn hình)
SHOW_GUI=false

# ============================================================================
# 7. Màn hình phần cứng TFT ST7789V SPI (240x320) trên Raspberry Pi
# ============================================================================
TFT_ENABLED=true
TFT_WIDTH=320
TFT_HEIGHT=240
TFT_ROTATE=0
TFT_SPI_MHZ=32
TFT_DC_PIN=25
TFT_RESET_PIN=24
TFT_BGR=false
TFT_INVERT=false
TFT_DISPLAY_FPS=15

# ============================================================================
# 8. Cảm biến siêu âm Wake-on-Presence (Tiết kiệm CPU & Chống Spam)
# ============================================================================
# Bật/tắt cảm biến siêu âm (true: kích hoạt cơ chế ngủ/thức; false: AI chạy liên tục)
ULTRASONIC_ENABLED=true
# Chân GPIO BCM (TRIG pin 16 = GPIO 23, ECHO pin 13 = GPIO 27 qua cầu phân áp)
ULTRASONIC_TRIG_PIN=23
ULTRASONIC_ECHO_PIN=27
# Cự ly kích hoạt AI thức dậy (cm)
ULTRASONIC_TRIGGER_DISTANCE=50.0
# Cự ly tối đa hợp lệ (cm, lớn hơn 100cm coi là không có người)
ULTRASONIC_MAX_DISTANCE=100.0
# Thời gian đệm giữ trạng thái thức khi người vừa rời đi (giây)
ULTRASONIC_SLEEP_DELAY=5.0
# Thời gian mất dấu khuôn mặt để mở khóa đón người tiếp theo (giây)
FACE_LOST_RESET_SECONDS=1.5

# Optional direct mode notification; normally leave blank and use TB Mode Relay.
BACKEND_BASE_URL=
TB_WEBHOOK_SECRET=
