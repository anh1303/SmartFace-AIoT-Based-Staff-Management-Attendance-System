# Sao chép thành scripts/realtime/.env (không phải scripts/.env).
# Chạy simulator từ thư mục gốc repository, chỉ dùng database thử riêng.
# File này được nạp đầu tiên; simulator chỉ đọc file .env đầu tiên tìm thấy.
SIMULATOR_BASE_URL=http://localhost:3000
SIMULATOR_DEVICE_ID=PI4_FRONT_GATE

# Phải khớp backend/.env và Rule Chain; tối thiểu 24 ký tự.
TB_WEBHOOK_SECRET=change-me-webhook-secret-at-least-24-characters
# Phải khớp ATTENDANCE_STABLE_COUNT trong backend/.env và hardware/.env.
ATTENDANCE_STABLE_COUNT=1
SIMULATOR_TIMEOUT_SEC=10

# basic/debounce cần UUID và vector đúng của nhân viên thử đã có embedding active.
# Công cụ select_test_employee.cjs xuất scripts/realtime/known_face_embedding.json.
SIMULATOR_EMPLOYEE_ID=
# Đường dẫn tương đối theo thư mục làm việc khi chạy, hoặc dùng đường dẫn tuyệt đối.
SIMULATOR_EMBEDDING_FILE=
# SIMULATOR_EMBEDDING_FILE=scripts/realtime/known_face_embedding.json
