          "settings": {
            "cardHtml": "<div class=\"gate-status-card\">\n  <div class=\"header-row\">\n    <div class=\"device-name\">${entityLabel}</div>\n    <div class=\"badge status-badge\">● ${status}</div>\n  </div>\n  \n  <div class=\"telemetry-body\">\n    <div class=\"door-status-box\">\n      <div class=\"box-label\">TRẠNG THÁI CỬA CỔNG (SERVO)</div>\n      <div class=\"door-val door-${door_state:CLOSED}\">🚪 ${door_state:CLOSED}</div>\n    </div>\n    \n    <div class=\"telemetry-badges\">\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">Hiện diện:</span>\n        <span class=\"badge-val presence-${person_present:false}\">${person_present:false}</span>\n      </div>\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">AI State:</span>\n        <span class=\"badge-val badge-${ai_state}\">${ai_state}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer-row\">\n    <div class=\"info-item\">Camera: <span>640x480 (15 FPS)</span></div>\n    <div class=\"info-item\">Tốc độ: <span>${fps:0} FPS</span></div>\n    <div class=\"info-item\">Barrier: <span>GPIO 18 PWM</span></div>\n  </div>\n</div>",
            "cardCss": ".gate-status-card {\n  padding: 16px;\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border-radius: 12px;\n  color: #fff;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-sizing: border-box;\n}\n.header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.device-name {\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: #38bdf8;\n}\n.status-badge {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  padding: 4px 10px;\n  border-radius: 20px;\n  font-size: 0.8rem;\n  font-weight: 600;\n}\n.telemetry-body {\n  margin: 12px 0;\n}\n.door-status-box {\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 8px;\n  padding: 10px;\n  text-align: center;\n  margin-bottom: 12px;\n}\n.box-label {\n  font-size: 0.75rem;\n  color: #94a3b8;\n  letter-spacing: 0.05em;\n  margin-bottom: 4px;\n}\n.door-val {\n  font-size: 1.35rem;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n}\n.door-val.door-CLOSED { color: #10b981; }\n.door-val.door-OPEN_IN { color: #3b82f6; }\n.door-val.door-OPEN_OUT { color: #f59e0b; }\n.telemetry-badges {\n  display: flex;\n  gap: 10px;\n}\n.badge-item {\n  flex: 1;\n  background: rgba(255, 255, 255, 0.05);\n  border-radius: 6px;\n  padding: 8px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n}\n.badge-label {\n  font-size: 0.75rem;\n  color: #94a3b8;\n}\n.badge-val {\n  font-size: 0.95rem;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n.badge-val.presence-true { background: rgba(56, 189, 248, 0.25); color: #38bdf8; }\n.badge-val.presence-false { background: rgba(148, 163, 184, 0.15); color: #94a3b8; }\n.badge-val.badge-AWAKE { background: rgba(16, 185, 129, 0.25); color: #10b981; }\n.badge-val.badge-SLEEP { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }\n.footer-row {\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\n  padding-top: 10px;\n  font-size: 0.75rem;\n  color: #94a3b8;\n}\n.info-item span {\n  color: #cbd5e1;\n  font-weight: 600;\n}"
          },
