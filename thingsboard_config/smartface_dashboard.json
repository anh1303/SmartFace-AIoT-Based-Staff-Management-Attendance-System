          "settings": {
            "cardHtml": "<div class=\"mode-control-card\">\n  <div class=\"mode-header\">\n    <span class=\"mode-subtitle\">CHỌN CHẾ ĐỘ ĐIỂM DANH (NHẤN LẠI NÚT ĐANG BẬT ĐỂ TẮT)</span>\n    <span class=\"mode-current-pill pill-${current_mode}\">● ${current_mode}</span>\n  </div>\n  <div class=\"mode-buttons-grid\">\n    <div id=\"btnCheckIn\" class=\"mode-btn btn-checkin active-${checkin_active:false} mode-${current_mode}\">\n      <div id=\"btnCheckIn\" class=\"btn-icon\">⇥</div>\n      <div id=\"btnCheckIn\" class=\"btn-title\">VÀO CA</div>\n      <div id=\"btnCheckIn\" class=\"btn-code\">CHECK_IN</div>\n      <div id=\"btnCheckIn\" class=\"btn-dist\">Cảm biến #1: ${distance_checkin:0} cm</div>\n    </div>\n    <div id=\"btnCheckOut\" class=\"mode-btn btn-checkout active-${checkout_active:false} mode-${current_mode}\">\n      <div id=\"btnCheckOut\" class=\"btn-icon\">⇤</div>\n      <div id=\"btnCheckOut\" class=\"btn-title\">RA CA</div>\n      <div id=\"btnCheckOut\" class=\"btn-code\">CHECK_OUT</div>\n      <div id=\"btnCheckOut\" class=\"btn-dist\">Cảm biến #2: ${distance_checkout:0} cm</div>\n    </div>\n  </div>\n</div>",
            "cardCss": ".mode-control-card {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border: 1px solid #334155;\n  border-radius: 12px;\n  padding: 14px 18px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-sizing: border-box;\n  font-family: 'Inter', -apple-system, sans-serif;\n  user-select: none;\n}\n.mode-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n.mode-subtitle {\n  color: #94a3b8;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.mode-current-pill {\n  padding: 3px 10px;\n  border-radius: 999px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, 0.35);\n}\n.pill-CHECK_IN {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  border-color: rgba(16, 185, 129, 0.5);\n}\n.pill-CHECK_OUT {\n  background: rgba(245, 158, 11, 0.2);\n  color: #f59e0b;\n  border-color: rgba(245, 158, 11, 0.5);\n}\n.mode-buttons-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  flex: 1;\n}\n.mode-btn {\n  border-radius: 12px;\n  border: 2px solid #334155;\n  background: rgba(15, 23, 42, 0.65);\n  color: #94a3b8;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 10px 8px;\n  cursor: pointer;\n  transition: all 0.18s ease;\n  text-align: center;\n}\n.mode-btn:hover {\n  border-color: #64748b;\n  color: #e2e8f0;\n  transform: translateY(-1px);\n}\n.mode-btn:active {\n  transform: translateY(0px) scale(0.98);\n}\n.btn-icon {\n  font-size: 22px;\n  font-weight: 800;\n  line-height: 1;\n  margin-bottom: 4px;\n}\n.btn-title {\n  font-size: 16px;\n  font-weight: 800;\n  letter-spacing: 0.03em;\n}\n.btn-code {\n  font-size: 11px;\n  font-weight: 700;\n  opacity: 0.8;\n  margin-top: 2px;\n}\n.btn-dist {\n  font-size: 10px;\n  font-weight: 600;\n  margin-top: 6px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: rgba(255, 255, 255, 0.06);\n}\n.btn-checkin.active-true,\n.btn-checkin.mode-CHECK_IN {\n  background: linear-gradient(135deg, rgba(16, 185, 129, 0.32) 0%, rgba(5, 150, 105, 0.22) 100%);\n  border-color: #10b981;\n  color: #ecfdf5;\n  box-shadow: 0 0 20px rgba(16, 185, 129, 0.28);\n}\n.btn-checkin.active-true .btn-icon,\n.btn-checkin.mode-CHECK_IN .btn-icon {\n  color: #34d399;\n}\n.btn-checkout.active-true,\n.btn-checkout.mode-CHECK_OUT {\n  background: linear-gradient(135deg, rgba(245, 158, 11, 0.32) 0%, rgba(217, 119, 6, 0.22) 100%);\n  border-color: #f59e0b;\n  color: #fffbeb;\n  box-shadow: 0 0 20px rgba(245, 158, 11, 0.28);\n}\n.btn-checkout.active-true .btn-icon,\n.btn-checkout.mode-CHECK_OUT .btn-icon {\n  color: #fbbf24;\n}"
