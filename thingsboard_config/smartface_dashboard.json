          "settings": {
            "cardHtml": "<div class=\"gate-status-card\">\n  <div class=\"header-row\">\n    <div class=\"device-name\">${entityLabel}</div>\n    <div class=\"badge status-badge\">● ${status}</div>\n  </div>\n  \n  <div class=\"telemetry-body\">\n    <div class=\"mode-container\">\n      <div class=\"mode-label\">CHẾ ĐỘ ĐIỂM DANH HIỆN TẠI</div>\n      <div class=\"mode-value\">${current_mode}</div>\n    </div>\n    \n    <div class=\"telemetry-badges\">\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">AI State:</span>\n        <span class=\"badge-val badge-${ai_state}\">${ai_state}</span>\n      </div>\n      <div class=\"badge-item\">\n        <span class=\"badge-label\">Hiện diện:</span>\n        <span class=\"badge-val presence-${person_present:false}\">${person_present:false}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"footer-row\">\n    <div class=\"info-item\">Camera: <span>640x480 (cấu hình 15 FPS)</span></div>\n    <div class=\"info-item\">Tốc độ: <span>${fps:0} FPS</span></div>\n    <div class=\"info-item\">Model: <span>ArcFace + MiniFAS</span></div>\n  </div>\n</div>",
            "cardCss": ".gate-status-card {\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border: 1px solid #334155;\n  border-radius: 12px;\n  padding: 16px 22px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  box-sizing: border-box;\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n.header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.device-name {\n  color: #94a3b8;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n.status-badge {\n  background: rgba(16, 185, 129, 0.15);\n  color: #10b981;\n  border: 1px solid rgba(16, 185, 129, 0.4);\n  padding: 3px 10px;\n  border-radius: 20px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n}\n.telemetry-body {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 6px 0;\n}\n.mode-label {\n  color: #64748b;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.mode-value {\n  color: #38bdf8;\n  font-size: 28px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  text-shadow: 0 0 20px rgba(56, 189, 248, 0.3);\n}\n.telemetry-badges {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  align-items: flex-end;\n}\n.badge-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n}\n.badge-label {\n  color: #94a3b8;\n  font-weight: 600;\n}\n.badge-val {\n  padding: 2px 8px;\n  border-radius: 6px;\n  font-weight: 700;\n  font-size: 11px;\n}\n.badge-AWAKE {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n  border: 1px solid rgba(16, 185, 129, 0.4);\n}\n.badge-SLEEP {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, 0.3);\n}\n.presence-true {\n  background: rgba(56, 189, 248, 0.2);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.4);\n}\n.presence-false {\n  background: rgba(100, 116, 139, 0.2);\n  color: #94a3b8;\n  border: 1px solid rgba(100, 116, 139, 0.3);\n}\n.footer-row {\n  display: flex;\n  justify-content: space-between;\n  border-top: 1px solid #334155;\n  padding-top: 10px;\n}\n.info-item {\n  color: #64748b;\n  font-size: 11px;\n}\n.info-item span {\n  color: #cbd5e1;\n  font-weight: 600;\n}"
